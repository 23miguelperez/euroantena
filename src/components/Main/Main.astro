---
const main = [
    {
        Title: "Euroantena",
        Description: "Somos una ingeniería de telecomunicaciones especializada en desarrollo de proyectos, instalación y puesta en marcha de Infraestructuras Comunes de Telecomunicación (ICT), Redes de Cableado Estructurado, Videovigilancia, Intrusión, Domótica e Inmótica. Contamos con profesionales altamente cualificados para ofrecer además un servicio postventa de atención como servicio técnico.",
        Services: ["Proyectos ICT", "Redes de datos", "Domótica", "Videovigilancia"],
    }
];

const hero = main[0];
---

<!-- Fondo fijo con un degradado ligeramente más profundo para mejorar el contraste -->
<div class="fixed inset-0 -z-10 bg-[linear-gradient(to_bottom,rgba(43,27,24,0.94),rgba(111,78,55,0.84)),url('/images/main.png')] bg-cover bg-center bg-no-repeat"></div>

<main>
    <section id="inicio" class="inicio-section relative flex min-h-svh flex-col justify-center py-24 text-white">

        <div class="inicio-content w-[90%] mx-auto lg:w-[80%]">
            <div class="max-w-4xl">

                <!-- Título principal -->
                <h1 class="mt-6 text-5xl sm:text-7xl md:text-8xl lg:text-9xl leading-none tracking-tight text-white">
                    <span class="font-light text-amber-100/90">euro</span><span class="font-bold">antena</span>
                </h1>

                <!-- Descripción con borde lateral refinado -->
                <div class="mt-8 border-l-2 border-amber-200/70 pl-6">
                    <p class="text-base sm:text-lg md:text-xl leading-relaxed text-amber-50/90">
                        {hero.Description}
                    </p>
                </div>

                <!-- Píldoras de especialidades con efecto cristal -->
                <ul class="mt-8 flex flex-wrap gap-2.5">
                    {hero.Services.map((service) => (
                        <li class="flex items-center gap-2 rounded-lg border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs sm:text-sm font-medium text-amber-100 backdrop-blur-sm">
                            <span class="h-1.5 w-1.5 rounded-full bg-amber-200"></span>
                            {service}
                        </li>
                    ))}
                </ul>

                <!-- Botones de acción (CTAs) -->
                <div class="mt-10 flex flex-wrap items-center gap-4">
                    <a
                        href="#servicios"
                        class="group inline-flex items-center gap-2.5 rounded-xl bg-amber-200 px-6 py-3.5 text-sm sm:text-base font-bold text-[#3b281b] shadow-lg transition-all duration-300 hover:bg-amber-100 hover:-translate-y-0.5"
                    >
                        Explorar servicios
                        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                    </a>

                    <a
                        href="/s-tecnico"
                        class="inline-flex items-center gap-2 rounded-xl border border-white/25 bg-white/5 px-6 py-3.5 text-sm sm:text-base font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:border-amber-200/60 hover:bg-white/10"
                    >
                        Servicio técnico
                    </a>
                </div>

            </div>
        </div>

        <!-- Indicador de scroll interactivo -->
        <div
            class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-xs uppercase tracking-widest text-white"
        >
            <span>Descubre más</span>
            <svg class="h-5 w-5 motion-safe:animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </div>

    </section>
</main>
