---
const main = [
    {
        Title: "Euroantena",
        Description: "Somos una empresa especializada en la ingeniería de telecomunicaciones, en proyectos ICT, redes de datos y domótica.",
        Services: ["Proyectos ICT", "Redes de datos", "Domótica"]
    }
]
---

<!-- Fondo fijo: no se mueve al hacer scroll -->
<div class="fixed inset-0 -z-10 bg-[linear-gradient(to_bottom,rgba(62,39,35,0.95),rgba(139,94,60,0.85)),url('/images/main.png')] bg-cover bg-center bg-no-repeat"></div>

<main>
    <section id="inicio" class="inicio-section relative flex min-h-svh flex-col justify-center text-white">

        <div class="inicio-content w-[90%] mx-auto lg:w-[70%] lg:ml-20 lg:mx-0">

            <h1 class="text-6xl md:text-9xl leading-none tracking-tight">
                <span class="font-normal">Euro</span><span class="font-semibold">antena</span>
            </h1>

            <div class="mt-8 max-w-xl border-l-4 border-amber-100 pl-5">
                <p class="text-lg md:text-xl leading-relaxed text-amber-50">
                    {main[0].Description}
                </p>
            </div>

            <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm md:text-base">
                {main[0].Services.map((service) => (
                    <li class="flex items-center gap-2">
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-100"></span>
                        {service}
                    </li>
                ))}
            </ul>
        </div>

        <!-- Indicador de scroll -->
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-sm text-amber-100 hover:text-white transition-colors">
            <span>Descubre más</span>
            <svg class="h-6 w-6 motion-safe:animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </div>
    </section>

</main>