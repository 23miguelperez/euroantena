---
import Formulario from '../Contacto/Formulario.astro';

const contactDetails = [
    {
        label: "Teléfono directo",
        value: "+34 900 000 000",
        subtext: "Lunes a viernes · 08:30 a 18:00 h",
        href: "tel:+34900000000"
    },
    {
        label: "Correo electrónico",
        value: "info@euroantena.es",
        subtext: "Presupuestos, proyectos y consultas generales",
        href: "mailto:info@euroantena.es"
    },
    {
        label: "Oficina y almacén",
        value: "Dirección de oficina / delegación",
        subtext: "Atención presencial con cita previa",
        href: null
    }
];
---

<section id="contacto" class="relative isolate pt-12 pb-24 text-white">
    <!-- Tu máscara de fondo original -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 -top-64 -z-10
            bg-(--tertiary-color)/70
            mask-[linear-gradient(to_bottom,transparent,rgba(0,0,0,0.08)_5rem,rgba(0,0,0,0.25)_10rem,rgba(0,0,0,0.5)_15rem,rgba(0,0,0,0.78)_20rem,black_26rem)]
            [-webkit-mask-image:linear-gradient(to_bottom,transparent,rgba(0,0,0,0.08)_5rem,rgba(0,0,0,0.25)_10rem,rgba(0,0,0,0.5)_15rem,rgba(0,0,0,0.78)_20rem,black_26rem)]"
    ></div>

    <div class="mx-auto w-[90%] lg:w-[80%]">
        
        <!-- Encabezado a juego con el resto de secciones -->
        <div class="mb-12">
            <span class="text-xs font-semibold uppercase tracking-widest text-amber-200/80">
                Hablemos
            </span>
            <h2 class="mt-2 text-3xl font-bold text-white md:text-4xl">
                Contacta con <span class="font-light text-amber-100">Nosotros</span>
            </h2>
        </div>

        <!-- Contenedor principal en 12 columnas (7 formulario / 5 info) -->
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 items-start">
            
            <!-- Columna Izquierda: Formulario -->
            <div class="lg:col-span-7">
                <Formulario />
            </div>

            <!-- Columna Derecha: Información de la empresa -->
            <article class="flex flex-col justify-between gap-6 lg:col-span-5">
                
                <!-- Intro breve -->
                <div class="border-l-2 border-amber-200/70 pl-5">
                    <h3 class="text-xl font-bold text-white">
                        Asesoramiento técnico a medida
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-amber-50/80">
                        Tanto si necesitas redactar un proyecto ICT, modernizar las telecomunicaciones de tu edificio o instalar sistemas de seguridad y domótica, nuestro equipo de ingeniería te acompaña en cada fase.
                    </p>
                </div>

                <!-- Tarjetas de datos de contacto -->
                <div class="space-y-4">
                    {contactDetails.map((item) => (
                        <div class="group rounded-2xl border border-white/15 bg-white/5 p-5 backdrop-blur-sm transition-colors duration-300 hover:border-amber-200/40 hover:bg-white/10">
                            <span class="block text-[11px] font-bold uppercase tracking-widest text-amber-200">
                                {item.label}
                            </span>

                            {item.href ? (
                                <a
                                    href={item.href}
                                    class="mt-1 inline-block text-lg font-bold text-white transition-colors group-hover:text-amber-100"
                                >
                                    {item.value}
                                </a>
                            ) : (
                                <p class="mt-1 text-lg font-bold text-white">
                                    {item.value}
                                </p>
                            )}

                            <p class="mt-1 text-xs text-amber-50/65">
                                {item.subtext}
                            </p>
                        </div>
                    ))}
                </div>

                <!-- Acceso directo a cita previa de Servicio Técnico -->
                <div class="rounded-2xl border border-amber-200/30 bg-amber-100/10 p-5 backdrop-blur-sm">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-amber-200">
                                ¿Ya eres cliente?
                            </span>
                            <p class="mt-0.5 text-sm font-medium text-white">
                                Reserva cita directa con nuestro servicio técnico.
                            </p>
                        </div>
                        <a
                            href="/s-tecnico"
                            aria-label="Ir a servicio técnico"
                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-200 font-bold text-[#3b281b] transition-transform duration-300 hover:scale-105 hover:bg-amber-100"
                        >
                            →
                        </a>
                    </div>
                </div>

            </article>
        </div>

    </div>
</section>
