---
const services = [
    {
        title: "Domótica",
        description: "Ofrecemos servicios de instalación...",
        icon: "/icons/antenna.svg",
        img: "/images/01_Domotica.png",
        href: "#"
    },
    {
        title: "Inmótica",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/maintenance.svg",
        img: "/images/02_Inmotica.png",
        href: "#"
    },
    {
        title: "Seguridad",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/advice.svg",
        img: "/images/03_Seguridad.png",
        href: "#"
    },
    {
        title: "Cableado estructurado",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/telecom.svg",
        img: "/images/04_Cableado.png",
        href: "#"
    },
    {
        title: "Ingeniería de telecomunicaciones",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/network.svg",
        img: "/images/05_Ingeniería.png",
        href: "#"
    },
    {
        title: "Videovigilancia",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/project.svg",
        img: "/images/06_Videovigilancia.png",
        href: "#"
    }
];

const technicalService = {
    title: "Servicio técnico",
    description: "Soporte especializado, mantenimiento preventivo y resolución rápida de incidencias.",
    cta: "Solicitar asistencia",
    href: "/s-tecnico"
};
---

<section
    id="servicios"
    class="relative -mt-30 pt-60 pb-28 z-20
    bg-[linear-gradient(to_bottom,transparent,rgba(255,255,255,0.08)_5rem,rgba(255,255,255,0.25)_10rem,rgba(255,255,255,0.5)_15rem,rgba(255,255,255,0.78)_20rem,white_26rem)]"
>
    <div class="w-[90%] mx-auto lg:w-[80%]">
        
        <!-- Encabezado a juego con "Sobre Nosotros" -->
        <div class="mb-14">
            <span class="text-xs font-semibold tracking-widest uppercase text-[#6F4E37]">
                Soluciones integrales
            </span>
            <h2 class="mt-2 text-3xl font-bold text-neutral-900 md:text-4xl">
                Nuestros <span class="font-light text-[#6F4E37]">Servicios</span>
            </h2>
        </div>

        <!-- Cuadrícula de servicios -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
            {services.map((service, index) => (
                <a
                    href={service.href ?? "#"}
                    class="group relative flex min-h-64 flex-col justify-between overflow-hidden rounded-xl border border-[#6F4E37]/20 p-6 text-white shadow-md transition-all duration-500 hover:-translate-y-1 hover:border-amber-200/60 hover:shadow-2xl focus-visible:outline-2 focus-visible:outline-offset-2"
                >
                    <!-- Imagen de fondo con zoom -->
                    <div
                        class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 ease-out group-hover:scale-110"
                        style={`background-image: url('${service.img}')`}
                    ></div>

                    <!-- Degradado oscuro/marrón más rico para leer bien el texto -->
                    <div class="absolute inset-0 bg-linear-to-t from-[#3b281b]/95 via-[#6F4E37]/80 to-[#6F4E37]/50 transition-opacity duration-500 group-hover:opacity-85"></div>

                    <!-- Fila superior: Icono en caja cristal + Número de servicio -->
                    <div class="relative flex items-center justify-between">
                        <div class="flex h-11 w-11 items-center justify-center rounded-lg border border-white/20 bg-white/10 backdrop-blur-md transition-colors duration-300 group-hover:border-amber-200/50 group-hover:bg-amber-100/20">
                            <img src={service.icon} alt="" class="h-5 w-5 brightness-0 invert" />
                        </div>
                        <span class="font-mono text-sm font-semibold text-amber-200/80">
                            0{index + 1}
                        </span>
                    </div>

                    <!-- Fila inferior: Título, descripción breve y línea animada -->
                    <div class="relative mt-8">
                        <div class="flex items-end justify-between gap-4">
                            <h3 class="text-xl font-bold leading-snug text-white">
                                {service.title}
                            </h3>
                            <span class="shrink-0 text-2xl text-amber-200 opacity-70 transition-all duration-300 group-hover:translate-x-1.5 group-hover:opacity-100" aria-hidden="true">
                                →
                            </span>
                        </div>

                        <p class="mt-2 line-clamp-2 text-sm text-white/80">
                            {service.description}
                        </p>

                        <!-- Línea de acento en tono ámbar -->
                        <span class="mt-4 block h-0.5 w-12 bg-amber-200/70 transition-all duration-500 group-hover:w-full group-hover:bg-amber-200"></span>
                    </div>
                </a>
            ))}
        </div>

        <!-- Banner destacado de Servicio Técnico -->
        <div class="mt-10">
            <a
                href={technicalService.href}
                class="group relative flex flex-col items-start justify-between gap-6 overflow-hidden rounded-xl border border-[#6F4E37]/20 bg-[#faf7f5] p-6 shadow-sm transition-all duration-300 hover:border-[#6F4E37] hover:shadow-lg sm:flex-row sm:items-center md:p-8 focus-visible:outline-2 focus-visible:outline-offset-2"
            >
                <!-- Borde lateral decorativo marrón -->
                <div class="absolute inset-y-0 left-0 w-1.5 bg-[#6F4E37] transition-all duration-300 group-hover:w-2.5"></div>

                <div class="pl-2">
                    <div class="flex items-center gap-3">
                        <span class="inline-block rounded-md bg-[#6F4E37]/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-[#6F4E37]">
                            Soporte directo
                        </span>
                        <h3 class="text-xl font-bold text-neutral-900 md:text-2xl">
                            {technicalService.title}
                        </h3>
                    </div>
                    <p class="mt-1.5 text-sm text-neutral-600 md:text-base">
                        {technicalService.description}
                    </p>
                </div>

                <!-- Botón CTA con estilo sólido -->
                <span class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-[#6F4E37] px-5 py-3 text-sm font-semibold text-white shadow-sm transition-all duration-300 group-hover:bg-[#573c2a] group-hover:shadow">
                    {technicalService.cta}
                    <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                </span>
            </a>
        </div>

    </div>
</section>
