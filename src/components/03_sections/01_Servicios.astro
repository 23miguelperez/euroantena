---
const services = [
    {
        title: "Domótica",
        description: "Ofrecemos servicios de instalación...",
        icon: "/icons/antenna.svg",
        img: "/images/01_Domotica.png"
    },
    {
        title: "Inmótica",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/maintenance.svg",
        img: "/images/02_Inmotica.png"
    },
    {
        title: "Seguridad",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/advice.svg",
        img: "/images/03_Seguridad.png", href: "#"
    },
    {
        title: "Cableado estructurado",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/telecom.svg",
        img: "/images/04_Cableado.png", href: "#"
    },
    {
        title: "Ingeniería de telecomunicaciones",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/network.svg",
        img: "/images/05_Ingeniería.png", href: "#"
    },
    {
        title: "Proyectos llave en mano",
        description: "Lorem ipsum dolor sit amet...",
        icon: "/icons/project.svg",
        img: "/images/06_Llaves.png", href: "#"
    }
];

// Servicio aparte: se muestra centrado debajo de la cuadrícula
const technicalService = {
    title: "Servicio técnico",
    description: "",
    cta: "Solicitar asistencia",
    href: "/s-tecnico"
};
---

<section
    id="servicios"
    class="relative -mt-64 pt-96 pb-30
    bg-[linear-gradient(to_bottom,transparent,rgba(255,255,255,0.08)_5rem,rgba(255,255,255,0.25)_10rem,rgba(255,255,255,0.5)_15rem,rgba(255,255,255,0.78)_20rem,white_26rem)]"
>

        <div class="w-[90%] mx-auto lg:w-[80%]">
            <h2 class="mb-10">Servicios</h2>

            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 xl:grid-cols-3">
                {services.map((service) => (
                    <a
                        href={service.href ?? "#"}
                        class="group relative block min-h-56 overflow-hidden rounded text-white shadow-md transition-shadow duration-500 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 md:aspect-3/1 md:min-h-0"
                    >
                        <!-- Foto: hace zoom al pasar el ratón -->
                        <div
                            class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 ease-out group-hover:scale-110"
                            style={`background-image: url('${service.img}')`}
                        ></div>

                        <!-- Capa marrón: se aclara para que se vea más la foto -->
                        <div class="absolute inset-0 bg-linear-to-b from-[#6F4E37]/90 to-[#6F4E37]/75 transition-opacity duration-500 group-hover:opacity-70"></div>

                        <!-- Contenido -->
                        <div class="relative flex h-full items-center justify-between gap-3 p-6">
                            <div>
                                <div class="flex items-center gap-3">
                                    <h3 class="text-xl uppercase leading-tight">{service.title}</h3>
                                </div>
                                <!-- Línea que crece de izquierda a derecha -->
                                <span class="mt-3 block h-0.5 w-0 bg-white transition-all duration-500 group-hover:w-full"></span>
                            </div>

                            <!-- Flecha que aparece deslizándose -->
                            <span class="shrink-0 text-3xl opacity-0 transition-all duration-500 -translate-x-3 group-hover:translate-x-0 group-hover:opacity-100" aria-hidden="true">→</span>
                        </div>
                    </a>
                ))}
            </div>

            <!-- Servicio técnico -->
            <div class="mt-4 flex justify-center">
                <a
                    href={technicalService.href}
                    class="group flex w-full flex-col items-center rounded border-2 border-[#6F4E37] bg-white p-3 text-center text-[#6F4E37] shadow-md transition-colors duration-300 hover:bg-[#6F4E37] hover:text-white hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 lg:w-[calc((100%-1rem)/2)] xl:w-[calc((100%-2rem)/3)]"
                >
                    <h3 class="text-xl uppercase leading-tight">{technicalService.title}</h3>
                    <p class="text-sm">{technicalService.description}</p>
                    <span class="flex items-center gap-2 text-sm font-semibold">
                        {technicalService.cta}
                        <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                    </span>
                </a>
            </div>
        </div>

</section>