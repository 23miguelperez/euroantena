---
import Layout from "../../layouts/Layout.astro";
import { SERVICES, type ServiceItem } from "../../data/servicios";

export function getStaticPaths() {
    return SERVICES.map((service, index) => ({
        params: { slug: service.slug },
        props: {
            service,
            number: `0${index + 1}`,
            otherServices: SERVICES.filter((s) => s.slug !== service.slug)
        }
    }));
}

interface Props {
    service: ServiceItem;
    number: string;
    otherServices: ServiceItem[];
}

const { service, number, otherServices } = Astro.props;
---

<Layout>
    <main class="min-h-svh bg-[#faf7f5] pb-24 text-[#3E2723]">
        
        <!-- Cabecera oscura unificada -->
        <div class="bg-[linear-gradient(to_bottom,#2b1b18,#3E2723)] pt-32 pb-28 text-white">
            <div class="mx-auto w-[90%] lg:w-[80%]">
                
                <a href="/#servicios" class="group inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-amber-200/80 transition-colors hover:text-amber-100">
                    <span class="transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true">←</span>
                    Volver a servicios
                </a>

                <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl uppercase">
                    {service.title}
                </h1>

                <p class="mt-4 max-w-2xl border-l-2 border-amber-200/70 pl-5 text-base leading-relaxed text-amber-50/85 md:text-lg">
                    {service.shortDescription}
                </p>
            </div>
        </div>

        <!-- Contenido principal superpuesto (-mt-16) -->
        <div class="mx-auto -mt-16 w-[90%] lg:w-[80%]">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 items-start">
                
                <article class="rounded-2xl border border-[#6F4E37]/20 bg-white p-6 sm:p-10 shadow-xl lg:col-span-7">
                    <div class="flex items-center gap-3 border-b border-[#6F4E37]/10 pb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#6F4E37] text-white shadow-sm">
                            <img src={service.icon} alt="" class="h-6 w-6 brightness-0 invert" />
                        </div>
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-[#6F4E37]">Descripción técnica</span>
                            <h2 class="text-3xl! font-bold text-neutral-900">Soluciones en {service.title.toLowerCase()}</h2>
                        </div>
                    </div>

                    <!-- Introducción opcional -->
                    {service.intro && (
                        <p class="mt-6 text-base font-medium leading-relaxed text-[#3E2723]">
                            {service.intro}
                        </p>
                    )}

                    <!-- Logos de protocolos (KNX, LonWorks, Busing, ZigBee) -->
                    {service.protocolsLogos && (
                        <div class="mt-6 pb-8 border-b border-[#6F4E37]/10">
                            <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                                {service.protocolsLogos.map((logo) => (
                                    <div class="flex h-16 items-center justify-center rounded-xl border border-[#6F4E37]/15 bg-[#faf7f5] p-3">
                                        <img src={logo.src} alt={logo.name} title={logo.name} class="max-h-9 max-w-full object-contain" />
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    <!-- Subsecciones con sus párrafos y listas -->
                    <div class="mt-6 space-y-8 text-base leading-relaxed text-neutral-700">
                        {service.sections.map((sec) => (
                            <div class="space-y-3">
                                {sec.heading && (
                                    <h3 class="text-lg font-bold text-neutral-900">
                                        {sec.heading}
                                    </h3>
                                )}

                                {sec.paragraphs?.map((p) => (
                                    <p>{p}</p>
                                ))}

                                {sec.bullets && (
                                    <ul class="space-y-2.5 pt-1">
                                        {sec.bullets.map((bullet) => (
                                            <li class="flex items-start gap-3 text-sm sm:text-base text-neutral-700">
                                                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#6F4E37]"></span>
                                                <span>{bullet}</span>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        ))}
                    </div>

                    <!-- Logos de fabricantes (JUNG, Zennio, GIRA, etc.) -->
                    {service.brandsLogos && (
                        <div class="mt-6 border-t border-[#6F4E37]/10 pt-6">
                            <span class="block text-xs font-bold uppercase tracking-widest text-[#6F4E37]">
                                Marcas con las que trabajamos
                            </span>
                            <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                                {service.brandsLogos.map((logo) => (
                                    <div class="flex h-16 items-center justify-center rounded-xl border border-[#6F4E37]/15 bg-[#faf7f5] p-3">
                                        <img src={logo.src} alt={logo.name} title={logo.name} class="max-h-9 max-w-full object-contain" />
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    <!-- Llamadas a la acción al pie -->
                    <div class="mt-10 flex flex-wrap items-center gap-4 border-t border-[#6F4E37]/10 pt-6">
                        <a
                            href="/#contacto"
                            class="inline-flex items-center gap-2 rounded-xl bg-[#6F4E37] px-6 py-3 text-sm font-bold text-white shadow-md transition-all duration-300 hover:bg-[#3E2723]"
                        >
                            <span>Solicitar presupuesto</span>
                            <span aria-hidden="true">→</span>
                        </a>
                        <a
                            href="/s-tecnico"
                            class="inline-flex items-center gap-2 rounded-xl border border-[#6F4E37]/30 px-5 py-3 text-sm font-semibold text-[#6F4E37] transition-colors hover:bg-[#6F4E37]/5"
                        >
                            Soporte técnico
                        </a>
                    </div>
                </article>

                <!-- Columna Derecha: Foto destacada + Otros servicios (5 columnas) -->
                <aside class="space-y-8 lg:col-span-5 lg:sticky lg:top-28">
                    
                    <!-- Foto del servicio -->
                    <div class="overflow-hidden rounded-2xl border border-[#6F4E37]/20 bg-white p-2 shadow-xl">
                        <img
                            src={service.img}
                            alt={service.title}
                            class="aspect-4/3 w-full rounded-xl object-cover"
                        />
                    </div>

                    <!-- Navegación rápida entre el resto de servicios -->
                    <div class="rounded-2xl border border-[#6F4E37]/20 bg-white p-6 shadow-md">
                        <h3 class="text-xs font-bold uppercase tracking-widest text-[#6F4E37]">
                            Otras especialidades
                        </h3>
                        <ul class="mt-4 divide-y divide-[#6F4E37]/10">
                            {otherServices.map((other) => (
                                <li>
                                    <a
                                        href={`/servicios/${other.slug}`}
                                        class="group flex items-center justify-between py-3 text-sm font-semibold text-neutral-800 transition-colors hover:text-[#6F4E37]"
                                    >
                                        <span>{other.title}</span>
                                        <span class="text-[#6F4E37] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>

                </aside>

            </div>
        </div>
    </main>
</Layout>
